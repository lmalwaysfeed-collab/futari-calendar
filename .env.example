# このファイルをコピーして「.env」という名前にし、値を書きかえてください。
# Developer Portal の「Bot」ページの Token（他人に見せないこと）
DISCORD_TOKEN=ここにトークン
# Developer Portal の「General Information」ページの Application ID
DISCORD_CLIENT_ID=ここにアプリケーションID

# ---- サーバー管理（/サーバー）用。使わないなら空のままでOK ----
# 仕訳バトルのフォルダ（例: C:\Users\あなた\Documents\shiwake-battle）
SHIWAKE_DIR=
# cloudflared の場所（ふつうはこのままでOK）
CLOUDFLARED=cloudflared
# 1 にすると、botが起動したときに仕訳バトルも自動で起動
AUTO_START_SHIWAKE=0
# サーバー管理を使える人のDiscordユーザーID（カンマ区切り。空なら /設定 のふたり）
ADMIN_IDS=

# ---- アップデート用（/サーバー の「アップデート」ボタン） ----
# GitHub のリポジトリ（例: yourname/futari-calendar）
UPDATE_REPO=
